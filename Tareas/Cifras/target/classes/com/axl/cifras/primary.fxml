<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TextArea?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.axl.cifras.PrimaryController">
   <children>
      <Label text="BUENAS TARDES" />
      
      <!-- Campo de texto y Botón Desglosar -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
             <Label text="DINERO: " />
             <TextField fx:id="txt1" promptText="Ingrese un número" />
            
             <Button fx:id="btn2"  text="X" onAction="#switchToSecondary" />
            <Button fx:id="btn1" text="Desglosar" onAction="#desglozar" />
         </children>
      </HBox>
      
      <!-- AREAS GRANDES PARTE -->
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <!-- Pantallita 1 (Izquierda): Lista de Billetes y Monedas -->
            <TextArea fx:id="txtArea1" editable="false" prefHeight="220.0" prefWidth="160.0" text="Billetes de $500&#10;Billetes de $200&#10;Billetes de $100&#10;Billetes de $50&#10;Billetes de $20&#10;Monedas de $10&#10;Monedas de $5&#10;Monedas de $2&#10;Monedas de $1" />

            <!-- Pantallita 2 (Derecha): Cantidades resultantes -->
            <TextArea fx:id="txtArea2" prefHeight="220.0" prefWidth="120.0" promptText="Resultados..." />
         </children>
      </HBox>
      
      
         </children>
   
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>