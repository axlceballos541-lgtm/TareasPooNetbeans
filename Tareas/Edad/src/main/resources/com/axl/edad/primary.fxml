<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" fillWidth="false" prefHeight="140.0" prefWidth="359.0" snapToPixel="false" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.axl.edad.PrimaryController">
   <children>
      <HBox prefHeight="29.0" prefWidth="440.0" spacing="30.0">
         <children>
            <Label fx:id="lbl1" prefHeight="17.0" prefWidth="233.0" text="Escribe tu fecha de nacimiento:">
               <HBox.margin>
                  <Insets left="40.0" right="-30.0" />
               </HBox.margin></Label>
            <TextField fx:id="txt1" prefHeight="25.0" prefWidth="139.0">
               <HBox.margin>
                  <Insets left="-20.0" />
               </HBox.margin></TextField>
         </children>
         <VBox.margin>
            <Insets bottom="-20.0" left="-100.0" right="-70.0" />
         </VBox.margin>
      </HBox>
      <Label fx:id="lbl3" text="DD/MM/AAAA">
         <VBox.margin>
            <Insets left="90.0" right="-90.0" />
         </VBox.margin>
      </Label>
      <HBox prefHeight="8.0" prefWidth="200.0" spacing="50.0">
         <children>
            <Button fx:id="btn_acep" mnemonicParsing="false" onAction="#btn_acep" text="Calcula">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="btn_erase" mnemonicParsing="false" onAction="#btn_erase" text="Limpia" />
         </children>
      </HBox>
      <Label fx:id="lbl2" />
   </children>
   <padding>
      <Insets left="80.0" right="100.0" />
   </padding>
</VBox>