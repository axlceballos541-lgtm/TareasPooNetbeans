<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER_LEFT" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.cifrasyduvisores.PrimaryController">
   <children>
       <HBox spacing="30.0">
           <children>
             <Label text="Ingrese un numero" />
                <TextField fx:id="txt1" />
                 <Button fx:id="btn1" text="Analizar" onAction="#Analizar"/>
                    <Button fx:id="boton2" text="Limpiar" onAction="#Limpiar"/>
           </children>
      </HBox>
       <HBox spacing="40.0">
           <VBox spacing="10.0">
               <children>
               
               <HBox spacing="50.0">
                   <children>
                     <Label text="Cantidad de cifras" />
                     <TextField fx:id="txt2" />  
                   </children>  
               </HBox>
               <HBox spacing="5.0">
                   <children>
                     <Label text="Cantidad de cifras impares" />
                     <TextField fx:id="txt3" />  
                   </children>  
               </HBox>   
               <HBox spacing="20.0">
                   <children>
                     <Label text="Cantidad de cifras pares" />
                     <TextField fx:id="txt4" />  
                   </children>  
               </HBox>
               <HBox spacing="40.0">
                   <children>
                     <Label text="Suma total de cifras" />
                     <TextField fx:id="txt5" />  
                   </children>  
               </HBox>
               <HBox spacing="90.0">
                   <children>
                     <Label text="Cifra mayor" />
                     <TextField fx:id="txt6" />  
                   </children>  
               </HBox>
               <HBox spacing="90.0">
                   <children>
                     <Label text="Cifra menor" />
                     <TextField fx:id="txt7" />  
                   </children>  
               </HBox>
               </children> 
           </VBox>
           <VBox>
            <Label text="Divisores" />   
             <TextArea fx:id="txtarea" />  
           </VBox>
        
       </HBox>      
   </children>
   <padding>
      <Insets bottom="0.0" left="5.0" right="5.0" top="0.0" />
   </padding>
</VBox>