<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" prefHeight="350.0" prefWidth="250.0" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.axl.tabla.PrimaryController">
    <children>
        <HBox spacing="20.0">
            <children>
                <VBox spacing="10.0">
                    <children>
                        <Label text="Tabla del:" />
                        <TextField fx:id="txt1" prefWidth="50.0" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="btn1" onAction="#calcular" prefWidth="80.0" text="Calcular" />
                        <Button fx:id="btn2" onAction="#limpiar" prefWidth="80.0" text="Limpiar" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <TextArea fx:id="txt2" editable="false" prefHeight="220.0" prefWidth="210.0" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>